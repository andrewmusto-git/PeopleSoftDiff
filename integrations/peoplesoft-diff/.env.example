# ============================================================
# PeopleSoft Diff — Veza OAA Integration Configuration
# Copy this file to .env, fill in all values, and chmod 600.
# NEVER commit .env to version control.
# ============================================================

# -----------------------------------------------------------
# PeopleSoft Web Services source
# -----------------------------------------------------------

# Full base URL of the PeopleSoft HCM host including port.
# Example: https://your-peoplesoft-host.example.com:5043
PEOPLESOFT_BASE_URL=https://your-peoplesoft-host.example.com:5043

# Service account credentials for Basic auth
PEOPLESOFT_USERNAME=your_service_account
PEOPLESOFT_PASSWORD=your_password_here

# PeopleSoft query name to execute.
# Default connector behavior uses a differential query:
#   ZPS_SP_DIFFERNTIAL
# For full population syncs, set this to your full employee query name.
PEOPLESOFT_QUERY_NAME=ZPS_SP_DIFFERNTIAL

# -----------------------------------------------------------
# Veza target
# -----------------------------------------------------------

# Your Veza instance URL (no trailing slash)
# Example: https://your-org.veza.com
VEZA_URL=https://your-veza-instance.veza.com

# Veza API key — generate in Veza Settings > API Keys
VEZA_API_KEY=your_veza_api_key_here

# -----------------------------------------------------------
# OAA Provider settings (optional — override defaults)
# -----------------------------------------------------------

# PROVIDER_NAME=PeopleSoft HR
# DATASOURCE_NAME=PeopleSoft Differential
